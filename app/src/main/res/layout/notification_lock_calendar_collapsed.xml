<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="#1E293B">

    <ImageView
        android:id="@+id/ivNotifIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_calendar"
        android:contentDescription="@string/app_name"
        android:layout_marginEnd="10dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotifNextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_no_events"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvNotifNextTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All calendars synced"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNotifEventCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:textColor="#3B82F6"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="0 events" />
</LinearLayout>
